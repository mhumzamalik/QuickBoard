{
  "manifest_version": 3,
  "name": "QuickBoard",
  "version": "1.0.0",
  "description": "Quickly add notes and tasks to your QuickBoard boards from any web page.",
  "permissions": ["contextMenus", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "QuickBoard"
  }
}
